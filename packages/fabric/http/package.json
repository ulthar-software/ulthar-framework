{
  "name": "@fabric/http",
  "version": "0.0.1",
  "description": "A HTTP library for the Fabric framework",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "sideEffects": false,
  "devDependencies": {
    "@fabric/testing": "workspace:^",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "dependencies": {
    "@fabric/core": "workspace:^"
  },
  "scripts": {
    "dev": "tsc build --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "tsc",
    "build": "tsc -p tsconfig.build.json"
  }
}
