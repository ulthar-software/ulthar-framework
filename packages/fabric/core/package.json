{
  "name": "@fabric/core",
  "version": "0.0.1",
  "description": "Core functionality for the Fabric framework",
  "exports": {
    ".": "./dist/index.js",
    "./default-json-transformers": "./dist/json/default-json-transformers.js",
    "./validations": "./dist/validations/index.js",
    "./mocks": "./dist/domain/mocks.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "sideEffects": false,
  "devDependencies": {
    "@fabric/testing": "workspace:^",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "scripts": {
    "dev": "tsc --build --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "tsc",
    "build": "tsc -p tsconfig.build.json"
  }
}
