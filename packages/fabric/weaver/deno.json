{
  "name": "@fabric/weaver",
  "exports": {
    ".": "./index.ts",
    "./dom": "./dom/index.ts",
    "./builder": "./builder.ts"
  },
  "imports": {
    "@fabric/core": "jsr:@fabric/core",
    "esbuild": "npm:esbuild@0.20.2"
