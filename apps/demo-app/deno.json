{
  "tasks": {
    "dev": "deno run -A build/dev.ts",
    "build": "deno run -A build/build.ts",
    "test:coverage:details": "deno test --coverage && deno coverage --detailed --include=$(basename $(pwd))",
    "test:coverage": "deno test --coverage && deno coverage --include=$(basename $(pwd))",
    "test": "deno test",
    "test:debug": "deno test --inspect-wait"
  },
  "imports": {
    "@fabric/core": "jsr:@fabric/core",
    "@fabric/weaver": "jsr:@fabric/weaver",
    "tailwindcss": "npm:tailwindcss",
    "autoprefixer": "npm:autoprefixer",
    "postcss": "npm:postcss",
    "esbuild": "npm:esbuild@0.20.2"
  }
}
