{
  "name": "fabric-framework",
  "version": "0.0.1",
  "description": "A framework for building applications in Typescript",
  "packageManager": "yarn@4.7.0",
  "type": "module",
  "workspaces": [
    "packages/fabric/*",
    "packages/templates/*",
    "packages/examples/*",
    "apps/**/*"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultharsoftware/fabric-framework.git"
  },
  "keywords": [
    "typescript",
    "framework",
    "fabric"
  ],
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@vitest/coverage-v8": "3.0.6",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^0.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6",
    "zx": "^8.3.2"
  },
  "scripts": {
    "lint": "eslint . --fix --report-unused-disable-directives",
    "fmt": "prettier --write .",
    "check": "tsc",
    "postinstall": "husky",
    "apps:build": "yarn workspaces foreach -vvA --topological --include 'apps/**/*' run build",
    "apps:test": "yarn workspaces foreach -vvA --topological --include 'apps/**/*' run test",
    "libs:test": "yarn workspaces foreach -vvA --include 'packages/**/*' run test",
    "libs:build": "yarn packages/fabric/core build && yarn packages/fabric/sqlite-store build",
    "ci:test": "yarn workspaces foreach -vvA run test",
    "ci:build": "yarn workspaces foreach -vvA --topological run build",
    "full:test": "cross-env RUN_ALL_TESTS=true yarn workspaces foreach -vvA run test",
    "apps:academy:build": "yarn workspaces foreach -vvA --topological --include 'apps/academy/*' run build",
    "academy:prepare": "yarn libs:build && yarn apps:academy:build"
  }
}
